% その分だけ parshape の行数を早く使い切って $v=f\lambda$ の式が図に重なる．2行足して[21]にした．
\begin{wrapfigure}[21]{r}[5mm]{90mm}
  \centering
  \vspace{-5mm}
  \includegraphics[keepaspectratio,width=90mm]
  {text_p85_fig2.png}
